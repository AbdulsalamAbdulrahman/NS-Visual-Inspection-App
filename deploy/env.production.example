# KENS production settings. Copied once to <base>/shared/.env on the server
# (docs/DEPLOY.md) and never committed. Every release links to it.

APP_NAME=KENS
APP_ENV=production
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=https://kens.buildingelectcert.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# DirectAdmin → MySQL Management. Names are prefixed with the account (buildin1_).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=buildin1_kens
DB_USERNAME=buildin1_kens
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Transactional email (login details, password resets, submission receipts).
# DirectAdmin → E-mail Accounts: create no-reply@kens.buildingelectcert.com.ng,
# then use the server's SMTP (or a provider such as Brevo / Mailgun).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=da38.host-ww.net
MAIL_PORT=465
MAIL_USERNAME=no-reply@kens.buildingelectcert.com.ng
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@kens.buildingelectcert.com.ng"
MAIL_FROM_NAME="Kaduna Electric NSD"

# New Service Department contact (forgot password / suspended screens)
NSD_PHONE="+234 800 000 0000"
NSD_EMAIL="nsd@kadunaelectric.com"

# Ticket QR codes link here: /verify/{ticket}
KENS_VERIFY_BASE_URL=https://kens.buildingelectcert.com.ng

# Monnify. Keep the sandbox until testing is done, then switch to
# https://api.monnify.com with the live keys.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Sandbox notifications aren't signed: keep false on sandbox, true with live keys.
MONNIFY_VERIFY_SIGNATURE=false
# Optional comma-separated allow-list of Monnify webhook IPs.
MONNIFY_WEBHOOK_IPS=
